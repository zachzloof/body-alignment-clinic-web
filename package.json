{
  "name": "body-alignment-clinic-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Website for Body Alignment Clinic, Rainham, Essex",
  "scripts": {
    "images": "node scripts/optimize-images.mjs",
    "dev": "npm run images && vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run images && vue-tsc --noEmit && vite-ssg build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@unhead/vue": "^2.1.17",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-ssg": "^28.3.0",
    "vue-tsc": "^3.3.14"
  }
}
